{
  "name": "dsh-plugin-reveal",
  "version": "0.1.0",
  "description": "给 DSH 的 agent 一个 reveal(path) 工具：在右侧栏里把文件摊开给人看",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/cordis": "4.0.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}

{
  "name": "dsh-plugins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "自研的 DSH（DeepSeek Harness）插件：多包一仓",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "check:dist": "node scripts/check-dist.mjs",
    "e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:dev": "node scripts/install-dev.mjs",
    "pack:all": "node scripts/pack-all.mjs",
    "release": "pnpm build && changeset publish",
    "test": "pnpm build && pnpm -r test",
    "test:only": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
